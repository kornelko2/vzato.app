        }
      }
    },
    "Warn before running out": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornit před dojitím zásoby"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyelmeztetés az elfogyás előtt"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorniť pred minutím zásoby"
          }
        }
      }
    },
    "Warn when below": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornit pod"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Figyelmeztetés ez alatt"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorniť pod"
          }
        }
      }
    },
    "What is the medication called?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak se lék jmenuje?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi a gyógyszer neve?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako sa liek volá?"
          }
        }
      }
    },
    "When a reminder comes": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přijde připomínka"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor emlékeztető érkezik"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď príde pripomienka"
          }
        }
      }
    },
    "When do you take it?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdy ho berete?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikor veszi be?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedy ho beriete?"
          }
        }
      }
    },
    "When it is time, Vzato reminds you. Then tap Taken.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Až přijde čas, Vzato vám to připomene. Pak klepněte na Vzato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor itt az ideje, a Vzato emlékezteti. Ekkor koppintson a Bevéve gombra."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď príde čas, Vzaté vám to pripomenie. Potom ťuknite na Vzaté."
          }
        }
      }
    },
    "When it is time, you only tap Taken. Vzato remembers that you took it, counts your supply and shows the history.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když přijde čas, jen klepnete na Vzato. Aplikace si zapamatuje, že jste lék vzali, hlídá zásobu a ukáže historii."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amikor itt az ideje, csak koppintson a Bevéve gombra. Az alkalmazás megjegyzi, hogy bevette, figyeli a készletet és mutatja az előzményeket."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Keď príde čas, iba ťuknete na Vzaté. Aplikácia si zapamätá, že ste liek vzali, stráži zásobu a ukáže históriu."
          }
        }
      }
    },
    "Who recorded what and when, on which device.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdo co zaznamenal, kdy a na kterém zařízení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki mit, mikor és melyik eszközön rögzített."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto čo zaznamenal, kedy a na ktorom zariadení."
          }
        }
      }
    },
    "Whole day": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý den"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egész nap"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Celý deň"
          }
        }
      }
    },
    "Why there is no Taken button": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proč tam není tlačítko Vzato"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Miért nincs Bevéve gomb"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prečo tam nie je tlačidlo Vzaté"
          }
        }
      }
    },
    "Widget": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget"
          }
        }
      }
    },
    "With a meal": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S jídlem"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Étkezés közben"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "S jedlom"
          }
        }
      }
    },
    "Without a record": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez záznamu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bejegyzés nélkül"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez záznamu"
          }
        }
      }
    },
    "Without notifications you will not hear or see a reminder at dose time, not even on the lock screen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez oznámení v čase dávky neuslyšíte ani neuvidíte žádnou připomínku, ani na zamčené obrazovce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítések nélkül az adag idején nem hall és nem lát emlékeztetőt, a zárolási képernyőn sem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez upozornení v čase dávky nebudete počuť ani vidieť žiadnu pripomienku, ani na zamknutej obrazovke."
          }
        }
      }
    },
    "Without them you will not hear a reminder and nothing appears on the lock screen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez nich připomínku neuslyšíte a na zamčené obrazovce se nic neukáže."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nélkülük nem hall emlékeztetőt, és a zárolási képernyőn sem jelenik meg semmi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez nich pripomienku nebudete počuť a na zamknutej obrazovke sa nič neukáže."
          }
        }
      }
    },
    "Write the name and how much you take at once.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište název a kolik si vezmete najednou."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írja be a nevet és azt, mennyit vesz be egyszerre."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte názov a koľko si vezmete naraz."
          }
        }
      }
    },
    "Write to us: info@vzato.app": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napište nám: info@vzato.app"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Írjon nekünk: info@vzato.app"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Napíšte nám: info@vzato.app"
          }
        }
      }
    },
    "You are out. Get more as soon as you can.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo. Zajděte pro další co nejdřív."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfogyott. Szerezzen be újat, amint tud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo. Zájdite po ďalšie čo najskôr."
          }
        }
      }
    },
    "You can eat now": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už můžete jíst"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most már ehet"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už môžete jesť"
          }
        }
      }
    },
    "Your count matches the records.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš počet odpovídá záznamům."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számolás egyezik a bejegyzésekkel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš počet zodpovedá záznamom."
          }
        }
      }
    },
    "Your data stays on this device and in your iCloud. Nothing is collected.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše data zůstávají v tomto zařízení a ve vašem iCloudu. Nic se nesbírá."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatai ezen az eszközön és az Ön iCloudjában maradnak. Semmit nem gyűjtünk."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše údaje zostávajú v tomto zariadení a vo vašom iCloude. Nič sa nezbiera."
          }
        }
      }
    },
    "Your iCloud account needs attention in the system settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš účet iCloud vyžaduje pozornost v nastavení systému."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-fiókja figyelmet igényel a rendszerbeállításokban."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš účet iCloud vyžaduje pozornosť v nastaveniach systému."
          }
        }
      }
    },
    "Your iCloud storage is full. Free up space or upgrade your iCloud plan; sync continues automatically afterwards.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše úložiště iCloud je plné. Uvolněte místo nebo navyšte tarif iCloud; synchronizace pak pokračuje sama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-tárhelye megtelt. Szabadítson fel helyet vagy bővítse az iCloud-csomagot; a szinkronizálás utána magától folytatódik."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše úložisko iCloud je plné. Uvoľnite miesto alebo navýšte plán iCloud; synchronizácia potom pokračuje sama."
          }
        }
      }
    },
    "Your next dose with Taken and Skip buttons.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příští dávka s tlačítky Vzato a Přeskočit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő adag a Bevéve és Kihagyás gombokkal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najbližšia dávka s tlačidlami Vzaté a Preskočiť."
          }
        }
      }
    },
