    "iCloud is not reachable right now. Sync will retry on its own.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud teď není dostupný. Synchronizace to zkusí znovu sama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud most nem érhető el. A szinkronizálás magától újrapróbálkozik."
          }
        },
