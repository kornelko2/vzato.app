    "A dose confirmed on one device shows as taken on the others.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dávka potvrzená na jednom zařízení se na ostatních ukáže jako vzatá."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az egyik eszközön megerősített adag a többin is bevettként jelenik meg."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dávka potvrdená na jednom zariadení sa na ostatných ukáže ako vzatá."
          }
        }
      }
    },
    "A quarter tablet or a different amount can be set later in Medications.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čtvrt tablety nebo jiné množství nastavíte později v Lécích."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Negyed tablettát vagy más mennyiséget később a Gyógyszerek részben állíthat be."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Štvrť tablety alebo iné množstvo nastavíte neskôr v Liekoch."
          }
        }
      }
    },
