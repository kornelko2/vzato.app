    "Recorded by the patient in Vzato. Vzato is not a medical device; the records are the patient's own.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenal pacient v aplikaci Vzato. Vzato není zdravotnický prostředek, jde o vlastní záznamy pacienta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pácienst rögzítette a Vzato alkalmazásban. A Vzato nem orvostechnikai eszköz, ezek a páciens saját feljegyzései."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznamenal pacient v aplikácii Vzato. Vzato nie je zdravotnícka pomôcka, ide o vlastné záznamy pacienta."
          }
        }
      }
    },
