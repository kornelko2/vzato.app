    "Pick the unit: tablets, drops, millilitres and more. Half or quarter tablets work too. Each confirmed dose lowers the amount at home and you get a notification when it runs low.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvolte jednotku: tablety, kapky, mililitry a další. Půlka i čtvrtka tablety fungují také. Každá potvrzená dávka množství doma sníží a při docházení dostanete oznámení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki az egységet: tabletta, csepp, milliliter és más. Fél vagy negyed tabletta is megadható. Minden megerősített adag csökkenti az otthoni mennyiséget, és értesítést kap, ha fogytán van."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoľte jednotku: tablety, kvapky, mililitre a ďalšie. Polovica aj štvrtina tablety fungujú tiež. Každá potvrdená dávka množstvo doma zníži a pri dochádzaní dostanete upozornenie."
          }
        }
      }
    },
