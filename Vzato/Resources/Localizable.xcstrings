    "Tap Save.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Uložit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a Mentés gombra."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na Uložiť."
          }
        }
      }
    },
    "Tap Taken in the reminder or in the app. That is all.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Vzato v připomínce nebo v aplikaci. To je vše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a Bevéve gombra az emlékeztetőben vagy az alkalmazásban. Ennyi."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknite na Vzaté v pripomienke alebo v aplikácii. To je všetko."
          }
        }
      }
    },
    "Tap a day to see it or correct it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na den ho zobrazíte nebo opravíte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy napra koppintva megnézheti vagy javíthatja."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím na deň ho zobrazíte alebo opravíte."
          }
        }
      }
    },
    "Tapped by mistake? Tap Undo right away. Later, touch and hold the dose in the Whole day list and choose Reset.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepli jste omylem? Hned klepněte na Vrátit. Později podržte prst na dávce v seznamu Celý den a vyberte Vrátit zpět."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tévedésből koppintott? Azonnal koppintson a Visszavonás gombra. Később tartsa az ujját az adagon az Egész nap listában, és válassza a Visszaállítás lehetőséget."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťukli ste omylom? Hneď ťuknite na Vrátiť. Neskôr podržte prst na dávke v zozname Celý deň a vyberte Vrátiť späť."
          }
        }
      }
    },
    "Teaspoons": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lžičky"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiskanál"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyžičky"
          }
        }
      }
    },
    "The Taken button appears from 30 minutes before the dose. This protects you from taking a dose twice.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačítko Vzato se ukáže 30 minut před dávkou. Chrání vás tak před tím, abyste dávku vzali dvakrát."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bevéve gomb 30 perccel az adag előtt jelenik meg. Így véd attól, hogy kétszer vegye be az adagot."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tlačidlo Vzaté sa ukáže 30 minút pred dávkou. Chráni vás tak pred tým, aby ste dávku vzali dvakrát."
          }
        }
      }
    },
    "The chosen photo appears on the big card next to the Taken button.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraná fotografie se zobrazí na velké kartě u tlačítka Vzato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiválasztott fotó a nagy kártyán jelenik meg a Bevéve gomb mellett."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraná fotografia sa zobrazí na veľkej karte pri tlačidle Vzaté."
          }
        }
      }
    },
    "The medication could not be saved. Try again.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lék se nepodařilo uložit. Zkuste to znovu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyógyszert nem sikerült menteni. Próbálja újra."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Liek sa nepodarilo uložiť. Skúste to znova."
          }
        }
      }
    },
    "The next dose on the Lock Screen.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příští dávka na zamčené obrazovce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő adag a zárolási képernyőn."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najbližšia dávka na zamknutej obrazovke."
          }
        }
      }
    },
    "This dose is planned for %@. Take it now, early?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato dávka je naplánovaná na %@. Vzít ji už teď?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az adag %@-ra van tervezve. Beveszi már most?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Táto dávka je naplánovaná na %@. Vziať ju už teraz?"
          }
