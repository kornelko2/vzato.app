      }
    },
    "Every day at %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý den v %@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden nap ekkor: %@"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý deň o %@"
          }
        }
      }
    },
    "Every day. Turn on one or more times; tap a time to change it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý den. Zapněte jeden nebo více časů; klepnutím na čas ho změníte."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden nap. Kapcsoljon be egy vagy több időpontot; az időpontra koppintva módosíthatja."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý deň. Zapnite jeden alebo viac časov; ťuknutím na čas ho zmeníte."
          }
        }
      }
    },
    "Every dose you take is subtracted from the supply.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá vzatá dávka se odečte ze zásoby."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden bevett adag levonódik a készletből."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá vzatá dávka sa odpočíta zo zásoby."
          }
        }
      }
    },
    "Every feature is free for everyone, including the source code. No ads, no account, no paid version.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny funkce jsou zdarma pro všechny, včetně zdrojového kódu. Bez reklam, bez účtu, bez placené verze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden funkció mindenkinek ingyenes, a forráskóddal együtt. Reklám, fiók és fizetős változat nélkül."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky funkcie sú zadarmo pre všetkých, vrátane zdrojového kódu. Bez reklám, bez účtu, bez platenej verzie."
          }
        }
      }
    },
    "Every scheduled dose is recorded.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny plánované dávky jsou zaznamenané."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden tervezett adag rögzítve van."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky plánované dávky sú zaznamenané."
          }
        }
      }
    },
    "Every taken, skipped or corrected dose is recorded here with the device it came from. Entries are never changed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá vzatá, přeskočená nebo opravená dávka se tu zaznamená i se zařízením, ze kterého přišla. Záznamy se nikdy nemění."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden bevett, kihagyott vagy javított adag itt rögzül azzal az eszközzel együtt, amelyről érkezett. A bejegyzések soha nem változnak."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá vzatá, preskočená alebo opravená dávka sa tu zaznamená aj so zariadením, z ktorého prišla. Záznamy sa nikdy nemenia."
          }
        }
      }
    },
