    "Turn them on in the system settings to get reminders.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapněte je v nastavení systému, abyste dostávali připomínky."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a rendszerbeállításokban, hogy emlékeztetőket kapjon."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnite ich v nastaveniach systému, aby ste dostávali pripomienky."
          }
        }
      }
    },
    "Units are tablets or other pieces; a half or a quarter tablet works too. Each confirmed dose lowers the count. You get a notification when it runs low.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusy jsou tablety nebo jiné jednotky; půlka i čtvrtka tablety fungují také. Každá potvrzená dávka počet sníží. Když zásoba dochází, dostanete oznámení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A darab tablettát vagy más egységet jelent; fél vagy negyed tabletta is megadható. Minden megerősített adag csökkenti a számot. Értesítést kap, ha fogytán van."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusy sú tablety alebo iné jednotky; polovica aj štvrtina tablety fungujú tiež. Každá potvrdená dávka počet zníži. Keď zásoba dochádza, dostanete upozornenie."
          }
        }
      }
    },
    "Units at home": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusů doma"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Darab otthon"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusov doma"
          }
        }
      }
    },
    "Units extra: %@. About %lld recorded doses may not have been taken. Review them in History.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusů navíc: %@. Asi %lld zaznamenaných dávek možná nebylo vzato. Zkontrolujte je v Historii."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Többlet: %@ darab. Körülbelül %lld rögzített adag talán nem lett bevéve. Ellenőrizze az Előzményekben."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusov navyše: %@. Asi %lld zaznamenaných dávok možno nebolo vzatých. Skontrolujte ich v Histórii."
          }
        }
      }
    },
    "Units missing: %@. That is about %lld doses taken without being recorded.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybí kusů: %@. To odpovídá asi %lld dávkám vzatým bez záznamu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiányzik: %@ darab. Ez körülbelül %lld rögzítés nélkül bevett adag."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chýba kusov: %@. To zodpovedá asi %lld dávkam vzatým bez záznamu."
          }
        }
      }
    },
    "Units per dose": {
      "localizations": {
        "cs": {
          "stringUnit": {
