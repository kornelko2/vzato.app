    "%@ was already taken at %@. Take another dose now?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ už byl vzat v %@. Opravdu vzít další dávku?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ már be lett véve %@-kor. Biztosan bevesz még egy adagot?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ už bol vzatý o %@. Naozaj vziať ďalšiu dávku?"
          }
        }
      }
    },
