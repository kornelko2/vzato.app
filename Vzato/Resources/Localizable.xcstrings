    "Archiving keeps the history. Deleting removes the medication and all its records.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivace zachová historii. Smazání odstraní lék i všechny jeho záznamy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az archiválás megőrzi az előzményeket. A törlés eltávolítja a gyógyszert és minden bejegyzését."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivácia zachová históriu. Vymazanie odstráni liek aj všetky jeho záznamy."
          }
        }
      }
    },
    "At dose time you hear a sound and see the reminder, also on the lock screen and on Apple Watch.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V čase dávky uslyšíte zvuk a uvidíte připomínku, i na zamčené obrazovce a na Apple Watch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adag idején hangot hall és látja az emlékeztetőt, a zárolási képernyőn és az Apple Watch-on is."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
