        }
      }
    },
    "No photos yet. Add the package, the pill or the leaflet so you always have them at hand.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné fotografie. Přidejte krabičku, tabletu nebo leták, ať je máte vždy po ruce."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs fotó. Adja hozzá a dobozt, a tablettát vagy a betegtájékoztatót, hogy mindig kéznél legyenek."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatiaľ žiadne fotografie. Pridajte škatuľku, tabletu alebo leták, aby ste ich mali vždy poruke."
          }
        }
      }
    },
    "Noon": {
      "localizations": {
        "cs": {
          "stringUnit": {
