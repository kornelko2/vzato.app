    "Every scheduled dose is recorded.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všechny plánované dávky jsou zaznamenané."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden tervezett adag rögzítve van."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Všetky plánované dávky sú zaznamenané."
          }
        }
      }
    },
    "Every taken, skipped or corrected dose is recorded here with the device it came from. Entries are never changed.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá vzatá, přeskočená nebo opravená dávka se tu zaznamená i se zařízením, ze kterého přišla. Záznamy se nikdy nemění."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden bevett, kihagyott vagy javított adag itt rögzül azzal az eszközzel együtt, amelyről érkezett. A bejegyzések soha nem változnak."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá vzatá, preskočená alebo opravená dávka sa tu zaznamená aj so zariadením, z ktorého prišla. Záznamy sa nikdy nemenia."
          }
        }
      }
    },
