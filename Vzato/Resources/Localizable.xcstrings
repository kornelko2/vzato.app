    "Every day": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý den"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden nap"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
