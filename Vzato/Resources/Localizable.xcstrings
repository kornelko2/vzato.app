      }
    },
    "Under Photo on Today choose which photo appears on the big card.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V části Fotografie v přehledu Dnes vyberte, která fotka se ukáže na velké kartě."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fotó a Ma nézetben opciónál válassza ki, melyik fotó jelenjen meg a nagy kártyán."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V časti Fotografia v prehľade Dnes vyberte, ktorá fotka sa ukáže na veľkej karte."
          }
        }
      }
    },
    "Under Schedule, set when you take it. Add time adds another one.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V části Plán nastavte, kdy ho berete. Přidat čas přidá další."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ütemezés részben állítsa be, mikor veszi be. Az Időpont hozzáadása újabbat ad hozzá."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V časti Plán nastavte, kedy ho beriete. Pridať čas pridá ďalší."
          }
        }
      }
    },
    "Undo": {
      "localizations": {
