    "Who recorded what and when, on which device.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kdo co zaznamenal, kdy a na kterém zařízení."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki mit, mikor és melyik eszközön rögzített."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto čo zaznamenal, kedy a na ktorom zariadení."
          }
        }
      }
    },
