    "Add your first medication with its dose and times. Vzato then reminds you.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte první lék s dávkou a časy. Vzato vám pak bude připomínat."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja hozzá az első gyógyszert az adaggal és az időpontokkal. A Vzato ezután emlékeztetni fogja."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte prvý liek s dávkou a časmi. Vzato vám potom bude pripomínať."
