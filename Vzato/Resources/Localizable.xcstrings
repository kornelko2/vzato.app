            "value": "S jedlom"
          }
        }
      }
    },
    "Without a record": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez záznamu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bejegyzés nélkül"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez záznamu"
          }
        }
      }
    },
    "You are out. Get more as soon as you can.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo. Zajděte pro další co nejdřív."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfogyott. Szerezzen be újat, amint tud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo. Zájdite po ďalšie čo najskôr."
          }
        }
      }
    },
    "You can eat now": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už můžete jíst"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most már ehet"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Už môžete jesť"
          }
        }
      }
    },
    "Your count matches the records.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš počet odpovídá záznamům."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számolás egyezik a bejegyzésekkel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš počet zodpovedá záznamom."
          }
        }
      }
    },
    "Your data stays on this device and in your iCloud. Nothing is collected.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše data zůstávají v tomto zařízení a ve vašem iCloudu. Nic se nesbírá."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatai ezen az eszközön és az Ön iCloudjában maradnak. Semmit nem gyűjtünk."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše údaje zostávajú v tomto zariadení a vo vašom iCloude. Nič sa nezbiera."
          }
        }
      }
    },
    "Your iCloud account needs attention in the system settings.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš účet iCloud vyžaduje pozornost v nastavení systému."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-fiókja figyelmet igényel a rendszerbeállításokban."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš účet iCloud vyžaduje pozornosť v nastaveniach systému."
          }
        }
      }
    },
    "Your iCloud storage is full. Free up space or upgrade your iCloud plan; sync continues automatically afterwards.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše úložiště iCloud je plné. Uvolněte místo nebo navyšte tarif iCloud; synchronizace pak pokračuje sama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iCloud-tárhelye megtelt. Szabadítson fel helyet vagy bővítse az iCloud-csomagot; a szinkronizálás utána magától folytatódik."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše úložisko iCloud je plné. Uvoľnite miesto alebo navýšte plán iCloud; synchronizácia potom pokračuje sama."
          }
        }
      }
    },
    "Your next dose with a Taken button.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příští dávka s tlačítkem Vzato."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő adag a Bevéve gombbal."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najbližšia dávka s tlačidlom Vzaté."
          }
        }
      }
    },
