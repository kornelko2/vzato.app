          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dátum konca"
          }
        }
      }
    },
    "Enter the number of units to start tracking this medication's supply.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte počet kusů a začněte sledovat zásobu tohoto léku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg a darabszámot a készlet követésének megkezdéséhez."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadajte počet kusov a začnite sledovať zásobu tohto lieku."
          }
        }
      }
    },
    "Evening": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
