            "state": "translated",
            "value": "Jednotka"
          }
        }
      }
    },
    "Units extra: %@. About %lld recorded doses may not have been taken. Review them in History.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusů navíc: %@. Asi %lld zaznamenaných dávek možná nebylo vzato. Zkontrolujte je v Historii."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Többlet: %@ darab. Körülbelül %lld rögzített adag talán nem lett bevéve. Ellenőrizze az Előzményekben."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusov navyše: %@. Asi %lld zaznamenaných dávok možno nebolo vzatých. Skontrolujte ich v Histórii."
          }
        }
      }
    },
    "Units missing: %@. That is about %lld doses taken without being recorded.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybí kusů: %@. To odpovídá asi %lld dávkám vzatým bez záznamu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiányzik: %@ darab. Ez körülbelül %lld rögzítés nélkül bevett adag."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chýba kusov: %@. To zodpovedá asi %lld dávkam vzatým bez záznamu."
          }
        }
      }
    },
    "Until": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eddig"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzió"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzia"
          }
        }
      }
    },
    "Vzato follows the language you set for it in the system settings. Czech, Slovak, English and Hungarian are available.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzato se řídí jazykem, který mu nastavíte v nastavení systému. K dispozici je čeština, slovenština, angličtina a maďarština."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vzato a rendszerbeállításokban az alkalmazáshoz megadott nyelvet követi. Cseh, szlovák, angol és magyar nyelven érhető el."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzato sa riadi jazykom, ktorý mu nastavíte v nastaveniach systému. K dispozícii je čeština, slovenčina, angličtina a maďarčina."
          }
        }
      }
    },
    "Vzato is not a medical device and does not replace your doctor or pharmacist. It only reminds you and keeps your own notes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzato není zdravotnický prostředek a nenahrazuje lékaře ani lékárníka. Jen připomíná a vede vaše vlastní záznamy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vzato nem orvostechnikai eszköz, és nem helyettesíti az orvost vagy a gyógyszerészt. Csak emlékeztet, és az Ön saját feljegyzéseit vezeti."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzato nie je zdravotnícka pomôcka a nenahrádza lekára ani lekárnika. Len pripomína a vedie vaše vlastné záznamy."
          }
        }
      }
    },
    "Vzato is not a medical device. Ask your doctor or pharmacist about your medications.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzato není zdravotnický prostředek. Na své léky se ptejte lékaře nebo lékárníka."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vzato nem orvostechnikai eszköz. A gyógyszereivel kapcsolatban kérdezze orvosát vagy gyógyszerészét."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzaté nie je zdravotnícka pomôcka. Na svoje lieky sa pýtajte lekára alebo lekárnika."
          }
        }
      }
    },
    "Vzato reminds you of your medications.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzato vám připomene léky."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Vzato emlékezteti a gyógyszereire."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzaté vám pripomenie lieky."
          }
        }
      }
    },
