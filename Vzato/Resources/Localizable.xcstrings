    "At the bottom of History is Summary for the doctor. Choose 7, 30 or 90 days and tap Export PDF to print or send it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dole v Historii je Souhrn pro lékaře. Vyberte 7, 30 nebo 90 dní a klepněte na Exportovat PDF, pak ho vytisknete nebo pošlete."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Előzmények alján található az Összefoglaló az orvosnak. Válasszon 7, 30 vagy 90 napot, és koppintson a PDF exportálása gombra a nyomtatáshoz vagy küldéshez."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dole v Histórii je Súhrn pre lekára. Vyberte 7, 30 alebo 90 dní a ťuknite na Exportovať PDF, potom ho vytlačíte alebo pošlete."
          }
        }
      }
    },
