        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzato uses the camera to photograph your medication, pills and leaflets. The photos stay on your device."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzato používa fotoaparát na odfotenie lieku, tabliet a príbalových letákov. Fotografie zostávajú vo vašom zariadení."
          }
        }
      }
