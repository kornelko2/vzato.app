    "Archiving keeps the history. Deleting removes the medication and all its records.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivace zachová historii. Smazání odstraní lék i všechny jeho záznamy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az archiválás megőrzi az előzményeket. A törlés eltávolítja a gyógyszert és minden bejegyzését."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivácia zachová históriu. Vymazanie odstráni liek aj všetky jeho záznamy."
          }
        }
      }
    },
