            "value": "Étkezés közben"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "S jedlom"
          }
        }
      }
    },
    "Without a record": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez záznamu"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bejegyzés nélkül"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez záznamu"
          }
        }
      }
    },
    "You are out. Get more as soon as you can.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo. Zajděte pro další co nejdřív."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elfogyott. Szerezzen be újat, amint tud."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo. Zájdite po ďalšie čo najskôr."
          }
        }
      }
    },
    "Your count matches the records.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš počet odpovídá záznamům."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A számolás egyezik a bejegyzésekkel."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš počet zodpovedá záznamom."
          }
        }
      }
    },
    "Your data stays on this device and in your iCloud. Nothing is collected.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše data zůstávají v tomto zařízení a ve vašem iCloudu. Nic se nesbírá."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatai ezen az eszközön és az Ön iCloudjában maradnak. Semmit nem gyűjtünk."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše údaje zostávajú v tomto zariadení a vo vašom iCloude. Nič sa nezbiera."
          }
        }
      }
    },
    "extra": {
