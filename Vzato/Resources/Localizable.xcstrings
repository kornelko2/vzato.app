    "iOS allows at most 64 scheduled reminders. Some times were not scheduled.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS dovolí nejvýše 64 naplánovaných připomínek. Některé časy nebyly naplánovány."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
