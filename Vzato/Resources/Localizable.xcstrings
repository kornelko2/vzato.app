    "iOS allows at most 64 scheduled reminders. Some times were not scheduled.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS dovolí nejvýše 64 naplánovaných připomínek. Některé časy nebyly naplánovány."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iOS legfeljebb 64 ütemezett emlékeztetőt enged. Néhány időpont nem lett ütemezve."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS dovolí najviac 64 naplánovaných pripomienok. Niektoré časy neboli naplánované."
          }
        }
      }
    }
